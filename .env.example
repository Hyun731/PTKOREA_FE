# Leave unset: the browser calls /v1 on the web origin and next.config.mjs proxies it to the API.
# NEXT_PUBLIC_API_URL=/v1

# Where the API server is. Read at build time (rewrites), so changing it needs a rebuild/redeploy.
# API_ORIGIN=http://127.0.0.1:8000

# Site password (HTTP Basic, any user name). Set when the app is reachable from outside.
# SHARE_PASSWORD=

# Same value as BACKEND_TOKEN in backend/.env. Sent to the API server-side only.
# BACKEND_TOKEN=
